# URL de l'API backend
# - Développement web          : http://localhost:3000
# - Développement mobile (LAN) : http://192.168.x.x:3000 (IP locale de la machine qui fait tourner le backend)
# - Production                 : https://api.ton-domaine.com
EXPO_PUBLIC_API_URL=

# ------------------------------------------------
# Google OAuth Web
# ------------------------------------------------
# Client ID de type "Application Web" - Google Cloud Console
# Utilisé par expo-auth-session pour le flow OAuth sur navigateur
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ------------------------------------------------
# Google OAuth Android
# ------------------------------------------------
# Client ID de type "Android" - Google Cloud Console
# Utilisé par @react-native-google-signin sur Android
# Nécessite le package name + empreinte SHA-1 dans Google Console
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ------------------------------------------------
# Google OAuth iOS
# ------------------------------------------------
# Client ID de type "iOS" - Google Cloud Console
# Utilisé par @react-native-google-signin sur iOS
# Nécessite le bundle identifier dans Google Console
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ------------------------------------------------
# Google OAuth UserInfo Endpoint
# ------------------------------------------------
# Endpoint Google pour récupérer les infos utilisateur via access_token
# Utilisé en fallback sur web quand Google ne renvoie pas d'id_token
# Ne pas modifier sauf changement de l'API Google
EXPO_PUBLIC_GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo