# ------------------------------------------------
# Prisma / API
# ------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5433/giveaway_test?schema=public"

# ------------------------------------------------
# App
# ------------------------------------------------
NODE_ENV=test

# ------------------------------------------------
# Throttler
# ------------------------------------------------
THROTTLER_DISABLED=true

# ------------------------------------------------
# JWT
# ------------------------------------------------
JWT_ACCESS_SECRET=test_access_secret
JWT_REFRESH_SECRET=test_refresh_secret
JWT_ACCESS_EXPIRES_IN="1m"
JWT_REFRESH_EXPIRES_IN="5m"

USE_DETERMINISTIC_OTP="true"

# ------------------------------------------------
# Vérification Association — Mock HTTP server
# ------------------------------------------------
# Démarré par apps/mobile/tests/global-setup.ts (cf. mock-association-api.ts).
# Permet de tester les chemins déterministes du AssociationVerificationService
# (validée, incohérente, dissoute, non-association, état inconnu).
ASSOCIATION_API_URL="http://localhost:4555/search"