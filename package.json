{
  "name": "GiveAWay",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "test:cov": "turbo run test:cov",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=api",
    "test:e2e:mobile": "turbo run test:e2e --filter=mobile",
    "test:e2e:mobile:ui": "npm run test:e2e:ui --workspace=apps/mobile",
    "db:test:setup": "npm run db:test:restart --workspace=apps/api"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}