# ------------------------------------------------
# Copier ce fichier en .env et remplir les valeurs appropriées

# ------------------------------------------------
# PostgreSQL
# ------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5434

# ------------------------------------------------
# Prisma / API
# ------------------------------------------------
# ⚠️ IMPORTANT :
# 1. Mettre "localhost" pour que les commandes "npm run db:migrate" fonctionnent depuis le terminal.
# 2. Mettre le même port que POSTGRES_PORT (ici 5434).
# 3. Ne pas utiliser de variables ${} ici, Prisma ne les lit pas nativement dans ce format.
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5434/POSTGRES_DB?schema=public"

# ------------------------------------------------
# pgAdmin
# ------------------------------------------------
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=8080

# ------------------------------------------------
# App
# ------------------------------------------------
NODE_ENV=development

# ------------------------------------------------
# Throttler
# ------------------------------------------------
THROTTLER_DISABLED=false

# ------------------------------------------------
# JWT
# ------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------
# JWT Admin (back-office)
# ------------------------------------------------
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_ACCESS_EXPIRES_IN="15m"
JWT_ADMIN_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------
# Admin
# ------------------------------------------------
ADMIN_LOGIN_URL="http://localhost:5173/login"
# Adresse vers laquelle les associations envoient leurs justificatifs par email
CONTACT_ADMIN_EMAIL="contact.giiveaway@gmail.com"
# CORS (prod uniquement) — séparées par virgules
CORS_ALLOWED_ORIGINS="https://admin.giveaway.fr,https://giveaway.fr"
ADMIN_BASE_URL="http://localhost:5173"

# ------------------------------------------------
# URLs
# ------------------------------------------------
# API NestJS
API_URL="http://localhost:3000"

# Appli React Native (via Deep Link) ou Web
# Pour le mobile, ce sera plus tard un schéma perso type : "giveaway://"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------
# Storage
# ------------------------------------------------
# Dev - Local
STORAGE_TYPE=local
# Prod
# STORAGE_TYPE=cloudinary

# ------------------------------------------------
# Cloudinary
# ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------
# Brevo
# ------------------------------------------------
BREVO_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=GiveAWay

# ------------------------------------------------
# Google OAuth Web
# ------------------------------------------------
GOOGLE_CLIENT_WEB_ID=

# ------------------------------------------------
# Google OAuth Android
# ------------------------------------------------
GOOGLE_ANDROID_CLIENT_ID=

# ------------------------------------------------
# Google OAuth iOS
# ------------------------------------------------
GOOGLE_IOS_CLIENT_ID=

# ------------------------------------------------
# Google OAuth UserInfo Endpoint
# ------------------------------------------------
# Endpoint Google pour récupérer les infos utilisateur via access_token
# Utilisé en fallback sur web quand Google ne renvoie pas d'id_token
# Ne pas modifier sauf changement de l'API Google
PUBLIC_GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

# ------------------------------------------------
# API Recherche Entreprises/Association
# ------------------------------------------------
ASSOCIATION_API_URL=https://recherche-entreprises.api.gouv.fr/search

# ------------------------------------------------
# URL de l'API Expo pour les notifications push
# ------------------------------------------------
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send