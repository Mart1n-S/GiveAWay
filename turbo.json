{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "$TURBO_DEFAULT$"
      ]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "$TURBO_DEFAULT$"
      ]
    },
    "test:e2e": {
      "cache": false,
      "interactive": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "admin#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@repo/shared#build"]
    },
    "admin#build": {
      "dependsOn": ["@repo/shared#build"],
      "outputs": ["dist/**"]
    }
  }
}
